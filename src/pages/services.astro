---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: 'home',
    title: 'Standard Cleaning',
    description: 'Our signature cleaning service covers all the essentials to keep your home fresh and inviting. Perfect for regular maintenance.',
    features: [
      'Dusting all accessible surfaces and furniture',
      'Vacuuming carpets, rugs, and floors',
      'Mopping hard floors',
      'Cleaning and sanitizing bathrooms',
      'Kitchen cleaning including countertops and appliances',
      'Making beds and tidying rooms',
      'Emptying trash bins',
      'Light organization'
    ],
    price: 'From $150',
    duration: '2-3 hours',
    featured: false
  },
  {
    icon: 'star',
    title: 'Deep Cleaning',
    description: 'An intensive, thorough cleaning that reaches every corner of your home. Recommended for first-time clients or seasonal refreshes.',
    features: [
      'Everything in Standard Cleaning plus:',
      'Inside oven and refrigerator cleaning',
      'Interior window cleaning',
      'Baseboards and door frames',
      'Light fixtures and ceiling fans',
      'Inside cabinets and drawers',
      'Behind and under furniture',
      'Detailed grout and tile cleaning'
    ],
    price: 'From $300',
    duration: '4-6 hours',
    featured: true
  },
  {
    icon: 'calendar',
    title: 'Recurring Service',
    description: 'Maintain a consistently clean home with our scheduled cleaning plans. Choose weekly, bi-weekly, or monthly service.',
    features: [
      'Customized cleaning checklist',
      'Same trusted cleaning team each visit',
      'Priority scheduling',
      'Discounted rates (up to 20% off)',
      'Flexible rescheduling',
      'Seasonal deep cleaning included',
      'Special requests accommodated',
      'Loyalty rewards program'
    ],
    price: 'From $120/visit',
    duration: '2-3 hours',
    featured: false
  },
  {
    icon: 'heart',
    title: 'Move In/Out Cleaning',
    description: 'Start fresh in your new home or leave your old one in pristine condition. Complete top-to-bottom cleaning for transitions.',
    features: [
      'Full deep cleaning of entire property',
      'Inside all appliances',
      'All closets and storage areas',
      'Interior windows and tracks',
      'Light fixtures and switches',
      'Garage cleaning (optional)',
      'Carpet steam cleaning (optional)',
      'Final walkthrough inspection'
    ],
    price: 'From $400',
    duration: '5-8 hours',
    featured: false
  },
  {
    icon: 'smile',
    title: 'Post-Event Cleaning',
    description: 'After hosting, let us restore your home to its original glory. From intimate gatherings to large celebrations.',
    features: [
      'Same or next day availability',
      'Trash and recycling removal',
      'Dish washing and kitchen cleanup',
      'Floor cleaning and restoration',
      'Furniture rearrangement',
      'Surface sanitization',
      'Bathroom refreshing',
      'Odor elimination treatment'
    ],
    price: 'From $200',
    duration: '3-5 hours',
    featured: false
  },
  {
    icon: 'shield',
    title: 'Sanitization Service',
    description: 'Hospital-grade disinfection for complete peace of mind. EPA-approved products safe for your family and pets.',
    features: [
      'EPA-approved disinfectants',
      'High-touch surface treatment',
      'Electrostatic spraying available',
      'Air purification treatment',
      'Antimicrobial coating option',
      'Safe for children and pets',
      'Allergen reduction',
      'Certification of completion'
    ],
    price: 'From $250',
    duration: '2-4 hours',
    featured: false
  }
];
---

<Layout title="Our Services | Xirlane Cleaning - Premium Residential Cleaning Philadelphia">
    <Navbar />
    
    <!-- Page Hero -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-tagline">What We Offer</p>
            <h1>Our Premium Services</h1>
            <p class="hero-description">Every service is delivered with meticulous attention to detail, using eco-friendly products and time-tested techniques.</p>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="services-detail">
        <div class="container">
            {services.map((service) => (
                <div class={`service-detail-card ${service.featured ? 'featured' : ''}`}>
                    {service.featured && <div class="featured-ribbon">Most Popular</div>}
                    <div class="service-header">
                        <div class="service-icon">
                            {service.icon === 'home' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            )}
                            {service.icon === 'star' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                            )}
                            {service.icon === 'calendar' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            )}
                            {service.icon === 'heart' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            )}
                            {service.icon === 'smile' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                                    <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                    <line x1="15" y1="9" x2="15.01" y2="9"></line>
                                </svg>
                            )}
                            {service.icon === 'shield' && (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            )}
                        </div>
                        <div class="service-title-wrap">
                            <h2>{service.title}</h2>
                            <p class="service-description">{service.description}</p>
                        </div>
                    </div>
                    <div class="service-body">
                        <div class="service-features">
                            <h3>What's Included</h3>
                            <ul>
                                {service.features.map((feature) => (
                                    <li>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        {feature}
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div class="service-pricing">
                            <div class="price-box">
                                <span class="price-label">Starting at</span>
                                <span class="price">{service.price}</span>
                                <span class="duration">{service.duration}</span>
                            </div>
                            <a href="/contact" class="btn btn-primary">Get a Quote</a>
                            <p class="price-note">Final price based on home size and condition</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq">
        <div class="container">
            <div class="section-header">
                <p class="section-tagline">Questions?</p>
                <h2 class="section-title">Frequently Asked Questions</h2>
            </div>
            <div class="faq-grid">
                <div class="faq-item">
                    <h3>How do you price your services?</h3>
                    <p>Pricing is based on the size of your home, its current condition, and the type of service requested. We provide free, no-obligation estimates after learning about your specific needs.</p>
                </div>
                <div class="faq-item">
                    <h3>Do I need to provide cleaning supplies?</h3>
                    <p>No! We bring all our own professional-grade, eco-friendly cleaning products and equipment. If you have specific products you'd like us to use, just let us know.</p>
                </div>
                <div class="faq-item">
                    <h3>Are your cleaners insured and background checked?</h3>
                    <p>Absolutely. Every team member is fully insured, bonded, and has passed a comprehensive background check for your peace of mind.</p>
                </div>
                <div class="faq-item">
                    <h3>Can I request the same cleaner each time?</h3>
                    <p>Yes! We encourage it. Consistency helps our team learn your preferences and maintain the standard you expect. Request your preferred team during booking.</p>
                </div>
                <div class="faq-item">
                    <h3>What if I'm not satisfied with the cleaning?</h3>
                    <p>Your satisfaction is guaranteed. If anything doesn't meet your expectations, contact us within 24 hours and we'll return to make it right at no extra charge.</p>
                </div>
                <div class="faq-item">
                    <h3>Do I need to be home during the cleaning?</h3>
                    <p>Not at all. Many of our clients provide a key or access code. We're fully insured and trustworthy—your home is safe with us.</p>
                </div>
            </div>
        </div>
    </section>

    <CTA />
    <Footer />
</Layout>

<style>
.page-hero {
    position: relative;
    padding: 180px 0 100px;
    background-image: url('https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=1920&h=600&fit=crop');
    background-size: cover;
    background-position: center;
    text-align: center;
}

.page-hero .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(26, 58, 47, 0.95) 0%, rgba(15, 38, 32, 0.9) 100%);
}

.page-hero .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
}

.page-hero .hero-tagline {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
}

.page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-white);
    margin-bottom: 20px;
}

.page-hero .hero-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
    margin: 0 auto;
}

.services-detail {
    padding: 100px 0;
    background-color: var(--color-off-white);
}

.service-detail-card {
    background: var(--color-white);
    margin-bottom: 40px;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
}

.service-detail-card.featured {
    border: 2px solid var(--color-accent);
}

.featured-ribbon {
    position: absolute;
    top: 20px;
    right: -35px;
    background: var(--color-accent);
    color: var(--color-primary-dark);
    padding: 8px 40px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transform: rotate(45deg);
}

.service-header {
    display: flex;
    gap: 30px;
    padding: 40px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    align-items: center;
}

.service-header .service-icon {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.service-header .service-icon svg {
    width: 40px;
    height: 40px;
    color: var(--color-accent);
}

.service-title-wrap h2 {
    color: var(--color-white);
    font-size: 1.75rem;
    margin-bottom: 10px;
}

.service-header .service-description {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    margin: 0;
}

.service-body {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
    padding: 40px;
}

.service-features h3 {
    font-size: 1.125rem;
    margin-bottom: 20px;
    color: var(--color-gray-800);
}

.service-features ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.service-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--color-text-light);
}

.service-features li svg {
    width: 18px;
    height: 18px;
    color: var(--color-accent-dark);
    flex-shrink: 0;
    margin-top: 2px;
}

.service-pricing {
    background: var(--color-cream);
    padding: 30px;
    text-align: center;
}

.price-box {
    margin-bottom: 20px;
}

.price-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-light);
    margin-bottom: 5px;
}

.price {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
}

.duration {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-top: 5px;
}

.price-note {
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-top: 15px;
}

.faq {
    padding: 100px 0;
    background: var(--color-white);
}

.faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

.faq-item {
    padding: 30px;
    background: var(--color-gray-100);
    border-left: 4px solid var(--color-accent);
}

.faq-item h3 {
    font-size: 1.125rem;
    margin-bottom: 12px;
    color: var(--color-gray-800);
}

.faq-item p {
    font-size: 0.9375rem;
    color: var(--color-text-light);
    line-height: 1.7;
}

@media (max-width: 1024px) {
    .service-body {
        grid-template-columns: 1fr;
    }
    
    .service-features ul {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .service-header {
        flex-direction: column;
        text-align: center;
        padding: 30px;
    }
    
    .service-body {
        padding: 30px;
    }
    
    .faq-grid {
        grid-template-columns: 1fr;
    }
}
</style>
