---
// CTA Section Component
---

<section class="cta">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Experience Premium Clean?</h2>
            <p>Join hundreds of satisfied Philadelphia homeowners who trust Xirlane Cleaning for their homes.</p>
            <div class="cta-buttons">
                <a href="#book" class="btn btn-light">Book Your Cleaning</a>
                <a href="tel:+12155551234" class="btn btn-outline-light">Call (215) 555-1234</a>
            </div>
        </div>
    </div>
</section>

<style>
.cta {
    padding: 100px 0;
    background-color: var(--color-accent);
    text-align: center;
}

.cta-content h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--color-primary-dark);
    margin-bottom: 16px;
}

.cta-content p {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 32px;
}

.cta-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.cta .btn-light {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
}

.cta .btn-light:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
}

.cta .btn-outline-light {
    color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
}

.cta .btn-outline-light:hover {
    background-color: var(--color-primary-dark);
    color: var(--color-white);
}
</style>
